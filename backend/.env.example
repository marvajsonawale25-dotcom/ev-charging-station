# ==========================================
# Spring Boot Backend Environment Variables
# ==========================================

# Server Port (Cloud platforms like Render/Railway automatically inject PORT)
PORT=8080

# Database Connection (PostgreSQL)
# Local development default:
DB_URL=jdbc:postgresql://localhost:5432/ev_charging_db
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password

# For Cloud PostgreSQL (Supabase, Neon, Railway, AWS RDS, Render):
# DB_URL=jdbc:postgresql://<HOST>:<PORT>/<DATABASE>?sslmode=require
# DB_USERNAME=<USER>
# DB_PASSWORD=<PASSWORD>

# JWT Security Configuration
# Generate a strong 256-bit base64-encoded secret key in production (e.g. openssl rand -base64 32):
JWT_SECRET=your_base64_encoded_256_bit_jwt_secret_here
JWT_EXPIRATION_MS=86400000

# Frontend URL (Allowed CORS Origin)
# Set this to your deployed Vercel domain in production:
# e.g., https://your-project.vercel.app
FRONTEND_URL=http://localhost:5173
