# ==========================================
# EV Charging Station Project - Environment Configuration Template
# ==========================================

# ------------------------------------------
# Backend Configuration (Spring Boot)
# ------------------------------------------

# Port (Cloud providers like Render/Railway automatically inject PORT)
PORT=8080

# Database Connection (PostgreSQL)
# Local:
DB_URL=jdbc:postgresql://localhost:5432/ev_charging_db
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password
# Cloud (e.g. Supabase, Neon, AWS RDS, Railway):
# DB_URL=jdbc:postgresql://<HOST>:<PORT>/<DATABASE>?sslmode=require
# DB_USERNAME=<USER>
# DB_PASSWORD=<PASSWORD>

# JWT Security
# Generate a strong 256-bit base64 secret in production (e.g., openssl rand -base64 32)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origin (Set to your Vercel URL in production)
FRONTEND_URL=http://localhost:5173

# ------------------------------------------
# Frontend Configuration (React + Vite)
# ------------------------------------------

# For Local Development:
VITE_API_URL=http://localhost:8080/api

# For Vercel Production:
# VITE_API_URL=https://YOUR-CLOUD-BACKEND-DOMAIN/api
